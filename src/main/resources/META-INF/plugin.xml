<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.razomy.notation.idea.plugin</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-name -->
    <name>Razomy Notation</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor email="support@razomy.com" url="https://www.razomy.com">Razomy</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Simple HTML elements (text formatting, paragraphs, and lists) can be added inside of <![CDATA[ ]]> tag.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-description -->
    <description>
        Razomy Notation as rn
        An "rn" data file is a versatile format for free-text descriptions that supports layering, composition, and
        key-value pairs.
        Plugin is designed for previewing "rn" data files.
    </description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <!--    <depends>com.intellij.modules.java</depends>-->
    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <lang.psiStructureViewFactory
                language="RN"
                implementationClass="com.razomy.notation.jetbrains.intellij.ide.plugin.editor.RnStructureViewFactory"/>
        <gotoSymbolContributor
                implementation="com.razomy.notation.jetbrains.intellij.ide.plugin.editor.RnChooseByNameContributor"/>
        <completion.contributor
                implementationClass="com.razomy.notation.jetbrains.intellij.ide.plugin.editor.RnCompletionContributor"
                language="RN"
        />
        <navbar implementation="com.razomy.notation.jetbrains.intellij.ide.plugin.editor.RnStructureAwareNavbar"/>
        <breadcrumbsInfoProvider
                implementation="com.razomy.notation.jetbrains.intellij.ide.plugin.editor.RnBreadcrumbsProvider"/>
        <fileType
                name="RN"
                implementationClass="com.razomy.notation.jetbrains.intellij.ide.plugin.editor.RnFileType"
                fieldName="INSTANCE"
                language="RN"
                extensions="rn"/>
        <lang.parserDefinition
                language="RN"
                implementationClass="com.razomy.notation.jetbrains.intellij.ide.plugin.editor.RnParserDefinition"/>
        <lang.syntaxHighlighterFactory
                language="RN"
                implementationClass="com.razomy.notation.jetbrains.intellij.ide.plugin.editor.RnSyntaxHighlighterFactory"/>
        <colorSettingsPage
                implementation="com.razomy.notation.jetbrains.intellij.ide.plugin.editor.RnColorSettingsPage"/>
        <lang.foldingBuilder
                language="RN"
                implementationClass="com.razomy.notation.jetbrains.intellij.ide.plugin.editor.RnFoldingBuilder"/>
        <!--        <lang.findUsagesProvider-->
        <!--                language="RN"-->
        <!--                implementationClass="com.razomy.notation.jetbrains.intellij.ide.plugin.editor.RnFindUsagesProvider"/>-->
        <!--        <lang.refactoringSupport-->
        <!--                language="RN"-->
        <!--                implementationClass="com.razomy.notation.jetbrains.intellij.ide.plugin.editor.RnRefactoringSupportProvider"/>-->
        <lang.commenter
                language="RN"
                implementationClass="com.razomy.notation.jetbrains.intellij.ide.plugin.editor.RnCommenter"/>
        <spellchecker.support language="RN"
                              implementationClass="com.razomy.notation.jetbrains.intellij.ide.plugin.editor.RnSpellCheckingStrategy"/>
        <lang.formatter
                language="RN"
                implementationClass="com.razomy.notation.jetbrains.intellij.ide.plugin.editor.RnFormattingModelBuilder"/>

        <multiHostInjector
                implementation="com.razomy.notation.jetbrains.intellij.ide.plugin.editor.RnMultiHostInjector"
        />
        <projectViewPane
                implementation="com.razomy.notation.jetbrains.intellij.ide.plugin.project.RnProjectViewPane"/>
        <annotator language="RN"
                   implementationClass="com.razomy.notation.jetbrains.intellij.ide.plugin.editor.RnAnnotator"/>
        <runLineMarkerContributor
                language="RN"
                implementationClass="com.razomy.notation.jetbrains.intellij.ide.plugin.editor.RnRunLineMarkerContributor"/>
        <configurationType
                implementation="com.razomy.notation.jetbrains.intellij.ide.plugin.editor.RnConfigurationType"/>
        <runConfigurationProducer
                implementation="com.razomy.notation.jetbrains.intellij.ide.plugin.editor.RnRunConfigurationProducer"/>
    </extensions>
    <actions>
        <group id="com.razomy.notation.jetbrains.intellij.ide.plugin.OpenInApp"
               text="Open In App"
               description="Open In App"
               popup="true"
               icon="AllIcons.Nodes.Toolbox">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="SplitRevealGroup"/>
            <add-to-group group-id="ChangesViewPopupMenu" anchor="before" relative-to-action="VersionControlsGroup"/>
            <action id="com.razomy.notation.jetbrains.intellij.ide.plugin.OpenInAppWebstorm"
                    class="com.razomy.notation.jetbrains.intellij.ide.plugin.project.OpenInApp"
                    text="WebStorm"
                    description="Open in WebStorm"
                    icon="AllIcons.FileTypes.Css">
            </action>
            <action id="com.razomy.notation.jetbrains.intellij.ide.plugin.OpenInAppIdea"
                    class="com.razomy.notation.jetbrains.intellij.ide.plugin.project.OpenInApp"
                    text="Idea"
                    description="Open in Idea"
                    icon="AllIcons.Ultimate.IdeaUltimatePromo">
            </action>
            <action id="com.razomy.notation.jetbrains.intellij.ide.plugin.OpenInAppPyCharm"
                    class="com.razomy.notation.jetbrains.intellij.ide.plugin.project.OpenInApp"
                    text="PyCharm"
                    description="Open in Python"
                    icon="AllIcons.Language.Python">
            </action>
        </group>
    </actions>
</idea-plugin>
