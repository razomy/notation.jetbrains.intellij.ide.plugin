<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.razomy.notation.idea.plugin</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-name -->
    <name>Razomy Notation</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor email="support@razomy.com" url="https://www.razomy.com">Razomy</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Simple HTML elements (text formatting, paragraphs, and lists) can be added inside of <![CDATA[ ]]> tag.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-description -->
    <description>
        Razomy Notation as rn
        An "rn" data file is a versatile format for free-text descriptions that supports layering, composition, and
        key-value pairs.
        Plugin is designed for previewing "rn" data files.
    </description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <!--    <depends>com.intellij.modules.java</depends>-->
    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <lang.psiStructureViewFactory
                language="RN"
                implementationClass="com.razomy.notation.jetbrains.intellij.ide.plugin.editor.RnStructureViewFactory"/>
        <gotoSymbolContributor
                implementation="com.razomy.notation.jetbrains.intellij.ide.plugin.editor.RnChooseByNameContributor"/>
        <completion.contributor
                implementationClass="com.razomy.notation.jetbrains.intellij.ide.plugin.editor.RnCompletionContributor"
                language="RN"
        />
        <navbar implementation="com.razomy.notation.jetbrains.intellij.ide.plugin.editor.RnStructureAwareNavbar"/>
        <breadcrumbsInfoProvider
                implementation="com.razomy.notation.jetbrains.intellij.ide.plugin.editor.RnBreadcrumbsProvider"/>
        <fileType
                name="RN"
                implementationClass="com.razomy.notation.jetbrains.intellij.ide.plugin.editor.RnFileType"
                fieldName="INSTANCE"
                language="RN"
                extensions="rn"/>
        <lang.parserDefinition
                language="RN"
                implementationClass="com.razomy.notation.jetbrains.intellij.ide.plugin.editor.RnParserDefinition"/>
        <lang.syntaxHighlighterFactory
                language="RN"
                implementationClass="com.razomy.notation.jetbrains.intellij.ide.plugin.editor.RnSyntaxHighlighterFactory"/>
        <colorSettingsPage
                implementation="com.razomy.notation.jetbrains.intellij.ide.plugin.editor.RnColorSettingsPage"/>
        <lang.foldingBuilder
                language="RN"
                implementationClass="com.razomy.notation.jetbrains.intellij.ide.plugin.editor.RnFoldingBuilder"/>
        <!--        <lang.findUsagesProvider-->
        <!--                language="RN"-->
        <!--                implementationClass="com.razomy.notation.jetbrains.intellij.ide.plugin.editor.RnFindUsagesProvider"/>-->
        <!--        <lang.refactoringSupport-->
        <!--                language="RN"-->
        <!--                implementationClass="com.razomy.notation.jetbrains.intellij.ide.plugin.editor.RnRefactoringSupportProvider"/>-->
        <lang.commenter
                language="RN"
                implementationClass="com.razomy.notation.jetbrains.intellij.ide.plugin.editor.RnCommenter"/>
        <spellchecker.support language="RN"
                              implementationClass="com.razomy.notation.jetbrains.intellij.ide.plugin.editor.RnSpellCheckingStrategy"/>
        <lang.formatter
                language="RN"
                implementationClass="com.razomy.notation.jetbrains.intellij.ide.plugin.editor.RnFormattingModelBuilder"/>

        <multiHostInjector
                implementation="com.razomy.notation.jetbrains.intellij.ide.plugin.editor.RnMultiHostInjector"
        />
        <projectViewPane
                implementation="com.razomy.notation.jetbrains.intellij.ide.plugin.project.RnProjectViewPane"/>
        <annotator language="RN"
                   implementationClass="com.razomy.notation.jetbrains.intellij.ide.plugin.editor.RnAnnotator"/>
        <runLineMarkerContributor
                language="RN"
                implementationClass="com.razomy.notation.jetbrains.intellij.ide.plugin.editor.RnRunLineMarkerContributor"/>
        <configurationType
                implementation="com.razomy.notation.jetbrains.intellij.ide.plugin.editor.RnConfigurationType"/>
        <runConfigurationProducer
                implementation="com.razomy.notation.jetbrains.intellij.ide.plugin.editor.RnRunConfigurationProducer"/>
        <toolWindow id="Local AI Chat"
                    anchor="right"
                    factoryClass="com.razomy.notation.jetbrains.intellij.ide.plugin.ai.AiChatToolWindowFactory"
                    icon="AllIcons.General.Web"/>
        <actionPromoter implementation="com.razomy.notation.jetbrains.intellij.ide.plugin.ai.InlineAiActionPromoter"/>

        <fileType name="Razomy File"
                  implementationClass="org.razomy.language.RazomyFileType"
                  fieldName="INSTANCE"
                  language="RL"
                  extensions="rl"/>

        <lang.parserDefinition language="RL"
                               implementationClass="org.razomy.language.parser.RazomyParserDefinition"/>

        <lang.syntaxHighlighterFactory language="RL"
                                       implementationClass="org.razomy.language.RazomySyntaxHighlighterFactory"/>

        <lang.braceMatcher language="RL"
                           implementationClass="org.razomy.language.RazomyBraceMatcher"/>

        <lang.foldingBuilder language="RL"
                             implementationClass="org.razomy.language.RazomyFoldingBuilder"/>

        <lang.commenter language="RL"
                        implementationClass="org.razomy.language.RazomyCommenter"/>

        <annotator language="RL"
                   implementationClass="org.razomy.language.RazomyAnnotator"/>

        <completion.contributor language="RL"
                                implementationClass="org.razomy.language.RazomyCompletionContributor"/>

        <psi.referenceContributor language="RL"
                                  implementation="org.razomy.language.RazomyReferenceContributor"/>

        <codeInsight.lineMarkerProvider language="RL"
                                        implementationClass="org.razomy.language.RazomyLineMarkerProvider"/>

        <lang.documentationProvider language="RL"
                                    implementationClass="org.razomy.language.RazomyDocumentationProvider"/>

        <lang.psiStructureViewFactory language="RL"
                                      implementationClass="org.razomy.language.RazomyStructureViewFactory"/>

        <lang.formatter language="RL"
                        implementationClass="org.razomy.language.RazomyFormattingModelBuilder"/>

        <gotoDeclarationHandler implementation="org.razomy.language.RazomyGotoDeclarationHandler"/>

        <localInspection language="RL"
                         groupName="Razomy"
                         displayName="Неиспользуемое объявление"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="org.razomy.language.RazomyUnusedInspection"/>
    </extensions>
    <actions>
        <group id="com.razomy.notation.jetbrains.intellij.ide.plugin.OpenInApp"
               text="Open In App"
               description="Open In App"
               popup="true"
               icon="AllIcons.Nodes.Toolbox">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="SplitRevealGroup"/>
            <add-to-group group-id="ChangesViewPopupMenu" anchor="before" relative-to-action="VersionControlsGroup"/>
            <action id="com.razomy.notation.jetbrains.intellij.ide.plugin.OpenInAppWebstorm"
                    class="com.razomy.notation.jetbrains.intellij.ide.plugin.project.OpenInAppAction"
                    text="WebStorm"
                    description="Open in WebStorm"
                    icon="AllIcons.FileTypes.Css">
            </action>
            <action id="com.razomy.notation.jetbrains.intellij.ide.plugin.OpenInAppIdea"
                    class="com.razomy.notation.jetbrains.intellij.ide.plugin.project.OpenInAppAction"
                    text="Idea"
                    description="Open in Idea"
                    icon="AllIcons.Ultimate.IdeaUltimatePromo">
            </action>
            <action id="com.razomy.notation.jetbrains.intellij.ide.plugin.OpenInAppPyCharm"
                    class="com.razomy.notation.jetbrains.intellij.ide.plugin.project.OpenInAppAction"
                    text="PyCharm"
                    description="Open in Python"
                    icon="AllIcons.Language.Python">
            </action>
            <action id="com.razomy.notation.jetbrains.intellij.ide.plugin.OpenInAppRider"
                    class="com.razomy.notation.jetbrains.intellij.ide.plugin.project.OpenInAppAction"
                    text="Rider"
                    description="Open in Rider"
                    icon="AllIcons.Actions.AddDirectory">
            </action>
            <action id="com.razomy.notation.jetbrains.intellij.ide.plugin.OpenInAppRust"
                    class="com.razomy.notation.jetbrains.intellij.ide.plugin.project.OpenInAppAction"
                    text="Rust"
                    description="Open in Rust"
                    icon="AllIcons.Language.Rust">
            </action>
            <action id="com.razomy.notation.jetbrains.intellij.ide.plugin.OpenInAppUnity"
                    class="com.razomy.notation.jetbrains.intellij.ide.plugin.project.OpenInAppAction"
                    text="Unity"
                    description="Open in Unity"
                    icon="AllIcons.Actions.AddDirectory">
            </action>
            <action id="com.razomy.notation.jetbrains.intellij.ide.plugin.OpenInAppChrome"
                    class="com.razomy.notation.jetbrains.intellij.ide.plugin.project.OpenInAppAction"
                    text="Chrome"
                    description="Open in Chrome"
                    icon="AllIcons.Actions.AddDirectory">
            </action>
        </group>

        <group id="ArrowInsertGroup" text="Insert Arrows" popup="true">
            <add-to-group group-id="EditMenu" anchor="last"/>

            <!-- Top Row -->
            <action id="ArrowNW" class="com.razomy.notation.jetbrains.intellij.ide.plugin.project.ArrowInsertAction$NorthWest" text="NW Arrow (↖)">
                <keyboard-shortcut first-keystroke="alt NUMPAD7" keymap="$default"/>
            </action>
            <action id="ArrowUp" class="com.razomy.notation.jetbrains.intellij.ide.plugin.project.ArrowInsertAction$Up" text="Up Arrow (↑)">
                <keyboard-shortcut first-keystroke="alt NUMPAD8" keymap="$default"/>
            </action>
            <action id="ArrowNE" class="com.razomy.notation.jetbrains.intellij.ide.plugin.project.ArrowInsertAction$NorthEast" text="NE Arrow (↗)">
                <keyboard-shortcut first-keystroke="alt NUMPAD9" keymap="$default"/>
            </action>

            <!-- Middle Row -->
            <action id="ArrowLeft" class="com.razomy.notation.jetbrains.intellij.ide.plugin.project.ArrowInsertAction$Left" text="Left Arrow (←)">
                <keyboard-shortcut first-keystroke="alt NUMPAD4" keymap="$default"/>
            </action>
            <action id="ArrowHoriz" class="com.razomy.notation.jetbrains.intellij.ide.plugin.project.ArrowInsertAction$Horizontal" text="Horizontal Arrow (↔)">
                <keyboard-shortcut first-keystroke="alt NUMPAD5" keymap="$default"/>
            </action>
            <action id="ArrowRight" class="com.razomy.notation.jetbrains.intellij.ide.plugin.project.ArrowInsertAction$Right" text="Right Arrow (→)">
                <keyboard-shortcut first-keystroke="alt NUMPAD6" keymap="$default"/>
            </action>

            <!-- Bottom Row -->
            <action id="ArrowSW" class="com.razomy.notation.jetbrains.intellij.ide.plugin.project.ArrowInsertAction$SouthWest" text="SW Arrow (↙)">
                <keyboard-shortcut first-keystroke="alt NUMPAD1" keymap="$default"/>
            </action>
            <action id="ArrowDown" class="com.razomy.notation.jetbrains.intellij.ide.plugin.project.ArrowInsertAction$Down" text="Down Arrow (↓)">
                <keyboard-shortcut first-keystroke="alt NUMPAD2" keymap="$default"/>
            </action>
            <action id="ArrowSE" class="com.razomy.notation.jetbrains.intellij.ide.plugin.project.ArrowInsertAction$SouthEast" text="SE Arrow (↘)">
                <keyboard-shortcut first-keystroke="alt NUMPAD3" keymap="$default"/>
            </action>

            <!-- Extra -->
            <action id="ArrowVert" class="com.razomy.notation.jetbrains.intellij.ide.plugin.project.ArrowInsertAction$Vertical" text="Vertical Arrow (↕)">
                <keyboard-shortcut first-keystroke="alt NUMPAD0" keymap="$default"/>
            </action>

            <action id="Delta" class="com.razomy.notation.jetbrains.intellij.ide.plugin.project.ArrowInsertAction$Delta" text="Delta (Δ)">
                <keyboard-shortcut first-keystroke="alt SUBTRACT" keymap="$default"/>
            </action>
        </group>
        <action id="Notation.InlineAiAction"
                class="com.razomy.notation.jetbrains.intellij.ide.plugin.ai.InlineAiAction"
                text="Inline AI Prompt"
                description="Ask local AI about selected code">
            <!-- Добавляем в меню правой кнопки мыши (чтобы можно было вызвать без клавиш) -->
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>

            <!-- Жесткая привязка Option + Space для всех Mac систем -->
            <keyboard-shortcut first-keystroke="meta I" keymap="Mac OS X" replace-all="true"/>
            <keyboard-shortcut first-keystroke="meta I" keymap="Mac OS X 10.5+" replace-all="true"/>
            <keyboard-shortcut first-keystroke="alt SPACE" keymap="Mac OS X" replace-all="true"/>
            <keyboard-shortcut first-keystroke="alt SPACE" keymap="Mac OS X 10.5+" replace-all="true"/>
            <keyboard-shortcut first-keystroke="alt SPACE" keymap="$default" replace-all="true"/>
        </action>
    </actions>
</idea-plugin>


