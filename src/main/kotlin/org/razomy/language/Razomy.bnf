{
  parserClass="org.razomy.language.parser.RazomyParser"
  parserUtilClass="org.razomy.language.RazomyParserUtil"

  extends="com.intellij.extapi.psi.ASTWrapperPsiElement"

  psiClassPrefix="Razomy"
  psiImplClassSuffix="Impl"
  psiPackage="org.razomy.language.psi"
  psiImplPackage="org.razomy.language.psi.impl"

  elementTypeHolderClass="org.razomy.language.psi.RazomyTypes"
  elementTypeClass="org.razomy.language.psi.RazomyElementType"
  tokenTypeClass="org.razomy.language.psi.RazomyTokenType"

  // Схлопывает все промежуточные узлы приоритетов выражений, оставляя чистые атомы!
  extends(".*_expr")=expr
  extends("literal|path|slot|form_block|flow_block")=expr
  tokens=[
    LBRACE='{'
    RBRACE='}'
    LBRACKET='['
    RBRACKET=']'
    LPAREN='('
    RPAREN=')'

    // Операторы пайплайна (Морфизмы)
    DOT_GT='.>'
    DOT_AMP='.&'
    DOT_PIPE='.|'
    DOT_QM='.?'
    DOT_RANGE='..'
    PIPE_DOT='.'
    DOT='.'

    // Сравнение и логика
    EQ_EQ='=='
    NOT_EQ='!='
    LTE='<='
    GTE='>='
    LANGLE='<'
    RANGLE='>'
    EQ='='
    AND_AND='&&'
    OR_OR='||'

    // Сдвиги и степень
    POW='**'
    SHIFT_L='<<'
    SHIFT_R='>>'

    // Алгебра типов и арифметика
    AMP='&'
    PIPE='|'
    SLASH='/'
    PLUS='+'
    MINUS='-'
    MUL='*'
    MOD='%'
    BANG='!'
    QM='?'

    // Разделители
    COMMA=','
    COLON=':'
    UNDERSCORE='_'
    SEMICOLON=';'

    // Литералы
    TRUE='true'
    FALSE='false'

    IDENTIFIER="regexp:[a-zA-Z][a-zA-Z0-9_]*|_[a-zA-Z0-9_]+"
    NUMBER="regexp:0x[0-9a-fA-F]+|\d+(\.\d+)?"
    STRING="regexp:\"([^\"\\]|\\.)*\"|'([^'\\]|\\.)*'"

    DOC_COMMENT="regexp:#[^#]*#"
    LINE_COMMENT="regexp://.*"
    CRLF2="regexp:\R"
    WHITE_SPACE="regexp:[ \t\r]+"
  ]
}

// 1. Корень файла
razomyFile ::= (CRLF2 | SEMICOLON | declaration)*

// 2. Декларация (поддерживает: Name Type, Fn(X) [ ... ], Name Type DefaultVal, и одиночные пайплайны)
declaration ::= expr expr* {pin=1}

// =============================================================================
// ИЕРАРХИЯ ВЫРАЖЕНИЙ (От низшего приоритета к высшему)
// =============================================================================

expr ::= pipeline_expr

// 1. Цепочки пайплайнов (., .., .?, .&, .>, .|)
pipeline_expr ::= union_expr ( (CRLF2)* pipeline_op (CRLF2)* union_expr )*
pipeline_op ::= DOT_GT | DOT_AMP | DOT_PIPE | DOT_QM | DOT_RANGE | PIPE_DOT

// 2. Алгебра типов и морфизмов (|, &, /)
union_expr    ::= merge_expr ( (CRLF2)* PIPE (CRLF2)* merge_expr )*
merge_expr    ::= subtract_expr ( (CRLF2)* AMP (CRLF2)* subtract_expr )*
subtract_expr ::= logic_expr ( (CRLF2)* SLASH (CRLF2)* logic_expr )*

// 3. Булева логика (&&, ||) и Сравнения (==, !=, <, >, <=, >=)
logic_expr   ::= compare_expr ( (CRLF2)* logic_op (CRLF2)* compare_expr )*
logic_op     ::= AND_AND | OR_OR

compare_expr ::= shift_expr ( (CRLF2)* compare_op (CRLF2)* shift_expr )*
compare_op   ::= EQ_EQ | NOT_EQ | LANGLE | RANGLE | LTE | GTE

// 4. Битовые сдвиги и Арифметика (<<, >>, +, -, *, %, **)
shift_expr ::= add_expr ( (CRLF2)* shift_op (CRLF2)* add_expr )*
shift_op   ::= SHIFT_L | SHIFT_R

add_expr ::= mul_expr ( (CRLF2)* add_op (CRLF2)* mul_expr )*
add_op   ::= PLUS | MINUS

mul_expr ::= pow_expr ( (CRLF2)* mul_op (CRLF2)* pow_expr )*
mul_op   ::= MUL | MOD

pow_expr ::= unary_expr ( (CRLF2)* POW (CRLF2)* unary_expr )*

// 5. Унарные операторы (!X, -5)
unary_expr ::= unary_op+ postfix_expr | postfix_expr
unary_op   ::= BANG | MINUS

// 6. Постфиксные цепочки: схлопнется в чистый path/literal, если нет суффиксов (), {}, []!
postfix_expr ::= primary_expr postfix_suffix*
private postfix_suffix ::= slot | form_block | flow_block

// primary_expr — просто прозрачный маршрутизатор к атомам
private primary_expr ::= literal
                       | form_block
                       | flow_block
                       | slot
                       | path

literal ::= NUMBER | STRING | TRUE | FALSE

// Обращение к полям слитное: User.Id, Err.Log, _.Age, Jonn.0, Jonn.-1
path ::= path_root (DOT path_node)* {
    mixin="org.razomy.language.RazomyPathMixin"
    implements="com.intellij.psi.PsiNameIdentifierOwner"
}
private path_root ::= IDENTIFIER | UNDERSCORE
private path_node ::= IDENTIFIER | NUMBER | (MINUS NUMBER)

// =============================================================================
// ТРИ СКОБКИ: СЛОТ (), ФОРМА {}, ПОТОК []
// =============================================================================

// () — Слот (кортежи, аргументы, группировка приоритетов)
slot ::= LPAREN (CRLF2 | SEMICOLON | COMMA | slot_item)* RPAREN
slot_item ::= expr expr* {pin=1}

// {} — Форма (структуры данных, паттерн-матчинг, словари)
form_block ::= LBRACE (CRLF2 | SEMICOLON | COMMA | form_item)* RBRACE
form_item ::= expr expr* {pin=1}

// [] — Поток (морфизмы/функции, пайплайны, предикаты, списки)
flow_block ::= LBRACKET (CRLF2 | SEMICOLON | COMMA | flow_item)* RBRACKET
flow_item ::= expr expr* {pin=1}