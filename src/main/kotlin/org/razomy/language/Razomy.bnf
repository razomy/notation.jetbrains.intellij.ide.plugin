{
  parserClass="org.razomy.language.parser.RazomyParser"
  parserUtilClass="org.razomy.language.parser.RazomyParserUtil"

  extends="com.intellij.extapi.psi.ASTWrapperPsiElement"

  psiClassPrefix="Razomy"
  psiImplClassSuffix="Impl"
  psiPackage="org.razomy.language.psi"
  psiImplPackage="org.razomy.language.psi.impl"

  elementTypeHolderClass="org.razomy.language.psi.RazomyTypes"
  elementTypeClass="org.razomy.language.psi.RazomyElementType"
  tokenTypeClass="org.razomy.language.psi.RazomyTokenType"

  tokens=[
    LBRACE='{'
    RBRACE='}'
    LPAREN='('
    RPAREN=')'
    LANGLE='<'
    RANGLE='>'
    LBRACKET='['
    RBRACKET=']'
    DOT='.'
    SEMICOLON=';'

    IDENTIFIER="regexp:[a-zA-Z_][a-zA-Z0-9_]*"
    NUMBER="regexp:\d+(\.\d+)?"
    STRING="regexp:\"[^\"]*\"|'[^']*'"
    OP="regexp:[&|\+\-\*/\!\?@\#\$%\^~=]+"

    LINE_COMMENT="regexp://.*"
    CRLF2="regexp:\R"
    WHITE_SPACE="regexp:[ \t\r]+"
  ]
}

// Корневой узел файла: набор утверждений или переводов строк
razomyFile ::= (CRLF2 | SEMICOLON | statement)*

// Утверждение (строка кода): одна или более сущностей
statement ::= token_item+

private token_item ::= path | STRING | NUMBER | OP | group

path ::= IDENTIFIER (DOT IDENTIFIER)*

group ::= brace_group | paren_group | angle_group | bracket_group

// Внутри групп statements также разделяются переносами строк
brace_group ::= LBRACE (CRLF2 | SEMICOLON | statement)* RBRACE
paren_group ::= LPAREN (CRLF2 | SEMICOLON | statement)* RPAREN
angle_group ::= LANGLE (CRLF2 | SEMICOLON | statement)* RANGLE
bracket_group ::= LBRACKET (CRLF2 | SEMICOLON | statement)* RBRACKET