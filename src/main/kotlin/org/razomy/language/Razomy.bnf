{
  parserClass="org.razomy.language.parser.RazomyParser"
  parserUtilClass="org.razomy.language.RazomyParserUtil"

  extends="com.intellij.extapi.psi.ASTWrapperPsiElement"

  psiClassPrefix="Razomy"
  psiImplClassSuffix="Impl"
  psiPackage="org.razomy.language.psi"
  psiImplPackage="org.razomy.language.psi.impl"

  elementTypeHolderClass="org.razomy.language.psi.RazomyTypes"
  elementTypeClass="org.razomy.language.psi.RazomyElementType"
  tokenTypeClass="org.razomy.language.psi.RazomyTokenType"

  tokens=[
    LBRACE='{'
    RBRACE='}'
    LBRACKET='['
    RBRACKET=']'
    LPAREN='('
    RPAREN=')'

    DOT_GT='.>'
    DOT_AMP='.&'
    MIGRATION='->'
    DOT='.'

    EQ_EQ='=='
    NOT_EQ='!='
    LTE='<='
    GTE='>='
    LANGLE='<'
    RANGLE='>'
    EQ='='

    AMP='&'
    PIPE='|'
    SLASH='/'
    PLUS='+'
    MINUS='-'
    MUL='*'

    COMMA=','
    UNDERSCORE='_'
    SEMICOLON=';'

    TRUE='true'
    FALSE='false'

    IDENTIFIER="regexp:[a-zA-Z][a-zA-Z0-9_]*|_[a-zA-Z0-9_]+"
    NUMBER="regexp:\d+(\.\d+)?"
    STRING="regexp:\"([^\"\\]|\\.)*\"|'([^'\\]|\\.)*'"

    LINE_COMMENT="regexp://.*"
    CRLF2="regexp:\R"
    WHITE_SPACE="regexp:[ \t\r]+"
  ]
}

// 1. Корень файла
razomyFile ::= (CRLF2 | SEMICOLON | declaration)*

// 2. Декларация на уровне файла (Имя + Значение/Блок)
declaration ::= expr expr? {pin=1}

// =============================================================================
// ИЕРАРХИЯ ВЫРАЖЕНИЙ (От наименьшего приоритета к наибольшему)
// =============================================================================

expr ::= pipeline_expr

pipeline_expr ::= migrate_expr ( (CRLF2)* pipeline_op (CRLF2)* migrate_expr )*
pipeline_op ::= DOT_GT | DOT_AMP | DOT

migrate_expr ::= union_expr ( (CRLF2)* MIGRATION (CRLF2)* union_expr )*

union_expr ::= merge_expr ( (CRLF2)* PIPE (CRLF2)* merge_expr )*
merge_expr ::= subtract_expr ( (CRLF2)* AMP (CRLF2)* subtract_expr )*
subtract_expr ::= compare_expr ( (CRLF2)* SLASH (CRLF2)* compare_expr )*

compare_expr ::= add_expr ( (CRLF2)* compare_op (CRLF2)* add_expr )*
compare_op ::= EQ_EQ | NOT_EQ | LANGLE | RANGLE | LTE | GTE

add_expr ::= mul_expr ( (CRLF2)* add_op (CRLF2)* mul_expr )*
add_op ::= PLUS | MINUS

mul_expr ::= primary_expr ( (CRLF2)* mul_op (CRLF2)* primary_expr )*
mul_op ::= MUL

// =============================================================================
// БАЗОВЫЕ СТРУКТУРЫ (ПЕРВИЧНЫЕ ВЫРАЖЕНИЯ)
// =============================================================================

primary_expr ::= literal
               | call_expr
               | typed_form_block
               | typed_flow_block
               | form_block
               | flow_block
               | path
               | slot

literal ::= NUMBER | STRING | TRUE | FALSE

call_expr ::= path slot
typed_form_block ::= path form_block
typed_flow_block ::= path flow_block

// Поддержка анонимного контекста в начале пути (например _.Age) и как одиночного токена (_)
path ::= path_root (DOT IDENTIFIER)* {
    mixin="org.razomy.language.RazomyPathMixin"
    implements="com.intellij.psi.PsiNameIdentifierOwner"
}
private path_root ::= IDENTIFIER | UNDERSCORE

// =============================================================================
// СКОБКИ И БЛОКИ (Формы, Потоки, Слоты)
// =============================================================================

// () — Слот (Захват объекта в переменную, Кортежи, Типизированные аргументы)
slot ::= LPAREN (CRLF2 | slot_item)? (COMMA (CRLF2 | slot_item))* RPAREN
slot_item ::= expr expr? {pin=1} // Поддержка `(U User)`

// {} — Форма (Структуры данных, Таблицы маршрутизации)
// Поддерживает запятые, точки с запятой и переносы строк как разделители
form_block ::= LBRACE (CRLF2 | SEMICOLON | COMMA | form_item)* RBRACE
form_item ::= expr expr? {pin=1} // Поддержка `Id Str` или `[ _ > 0 ] [ 300 ]`

// [] — Поток (Пайплайны, Предикаты)
flow_block ::= LBRACKET (CRLF2 | SEMICOLON | flow_item)* RBRACKET
flow_item ::= expr {pin=1} // Внутри пайплайна просто список выражений